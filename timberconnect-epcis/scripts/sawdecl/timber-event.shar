# sawdecl/serial-import.shar  -  Type specific function archive for sawing declaration as JSON from a PDF



_sawdecl__extract_input_identity () {
  sed -n 's/^"fields"."sawings"-[0-9][0-9]*: "materialInputEpc"-[0-9][0-9]*:[ \t]*/I/p' |
    sed 's/^I[ \t]*"\([^"]*\)"[ \t]*$/\1/'
}



_sawdecl__extract_product_identity () {
  sed -n 's/^"fields"."sawings"-[0-9][0-9]*: "materialEpc"-[0-9][0-9]*:[ \t]*/I/p' |
    sed 's/^I[ \t]*"\([^"]*\)"[ \t]*$/\1/'
}



_sawdecl__extract_document_identity () {
  sed -n 's/^"fields"."nr":[ \t]*/I/p' |
    sed 's/^I[ \t]*"\([^"]*\)"[ \t]*$/\1/'
}



canon__sawdecl () {
  local JOURNAL="${1-}"
  cat "${JOURNAL}" |
    encode_for_json_normalization |
    normalize_nested_json
}



hash__sawdecl () {
  _sawdecl__extract_document_identity |
    decode_from_json_normalization |
    sed 's/[ \t][ \t]*/_/g'
}



handle__sawdecl () {
  local INPUT_BUFFER="${1}"
  local PARENT_LIST="${2}"
  local INPUT_LIST="${3}"
  local IN_QUANT_LIST="${4}"
  local ITEM_LIST="${5}"
  local QUANT_LIST="${6}"
  local EVENT_TYPE="${7}"
  local GCP="${8}"
  local ITEM_REF="${9}"
  encode_for_json_normalization |
    normalize_nested_json |
    _sawdecl__extract_input_identity |
    decode_from_json_normalization >> "${INPUT_LIST}"
  cat "${INPUT_BUFFER}" |
    encode_for_json_normalization |
    normalize_nested_json |
    _sawdecl__extract_product_identity |
    decode_from_json_normalization >> "${ITEM_LIST}"
}
