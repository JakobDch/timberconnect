#======================================================================
# ERWEITERUNG 07/2026: PDF-Dokument-Integration (manuelle Datenerfassung)
# Neue Klasse + Properties fuer die 7 PDF-Templates des Upload-Flows:
#   Pruefzertifikat (Saatgut), LOCTITE-Klebstoffdatenblatt, Schnittbild,
#   Biegepruefung Schnittholz, Leistungserklaerung, Transportauftrag,
#   Stammzertifikat
#======================================================================

# --- Klassen ---------------------------------------------------------

tc:CuttingPattern a owl:Class ;
    rdfs:subClassOf tc:Document ;
    rdfs:label "Schnittbild"@de ;
    rdfs:label "Cutting Pattern"@en ;
    rdfs:comment "Saegewerks-Schnittbild: Einschnittplan eines Stammes mit Haupt- und Seitenware"@de .

# --- Pruefzertifikat Saatgut (Erweiterungen) -------------------------

tc:senderName a owl:DatatypeProperty ;
    rdfs:label "Einsender"@de ;
    rdfs:label "Sender name"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Name des Einsenders einer Probe"@de .

tc:otherSpeciesSeedPercentage a owl:DatatypeProperty ;
    rdfs:label "Samen anderer Arten"@de ;
    rdfs:label "Other species seed percentage"@en ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Anteil Samen anderer Arten in Prozent"@de .

tc:germinationSpeedWeeks a owl:DatatypeProperty ;
    rdfs:label "Keimschnelligkeit nach Wochen"@de ;
    rdfs:label "Germination speed weeks"@en ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Anzahl Wochen, nach denen die Keimschnelligkeit ermittelt wurde"@de .

tc:germinationRateWeeks a owl:DatatypeProperty ;
    rdfs:label "Keimfaehigkeit nach Wochen"@de ;
    rdfs:label "Germination rate weeks"@en ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Anzahl Wochen, nach denen die Keimfaehigkeit ermittelt wurde"@de .

# --- Klebstoff-Datenblatt (tc:Adhesive) ------------------------------

tc:technology a owl:DatatypeProperty ;
    rdfs:label "Technologie"@de ;
    rdfs:label "Technology"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Technologie eines Produkts (z.B. Polyurethan)"@de .

tc:applicationMethod a owl:DatatypeProperty ;
    rdfs:label "Auftrag"@de ;
    rdfs:label "Application method"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Auftragsverfahren (z.B. Flaechenverklebung, Keilzinkung)"@de .

tc:components a owl:DatatypeProperty ;
    rdfs:label "Komponenten"@de ;
    rdfs:label "Components"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Komponenten (z.B. einkomponentig)"@de .

tc:baseMaterial a owl:DatatypeProperty ;
    rdfs:label "Basis"@de ;
    rdfs:label "Base material"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Chemische Basis (z.B. Polyurethan-Prepolymer)"@de .

tc:consistency a owl:DatatypeProperty ;
    rdfs:label "Beschaffenheit"@de ;
    rdfs:label "Consistency"@en ;
    rdfs:range xsd:string .

tc:appearance a owl:DatatypeProperty ;
    rdfs:label "Aussehen"@de ;
    rdfs:label "Appearance"@en ;
    rdfs:range xsd:string .

tc:curingType a owl:DatatypeProperty ;
    rdfs:label "Aushaertung"@de ;
    rdfs:label "Curing type"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Aushaertungsmechanismus (z.B. feuchtigkeitshaertend)"@de .

tc:solidsContent a owl:DatatypeProperty ;
    rdfs:label "Feststoffgehalt"@de ;
    rdfs:label "Solids content"@en ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Feststoffgehalt in Prozent"@de .

tc:viscosity a owl:DatatypeProperty ;
    rdfs:label "Viskositaet"@de ;
    rdfs:label "Viscosity"@en ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Viskositaet in mPa.s"@de .

tc:viscosityConditions a owl:DatatypeProperty ;
    rdfs:label "Viskositaet Messbedingungen"@de ;
    rdfs:label "Viscosity conditions"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Messbedingungen der Viskositaet (Temperatur, Spindel, Drehzahl)"@de .

tc:processingNote a owl:DatatypeProperty ;
    rdfs:label "Verarbeitungshinweise"@de ;
    rdfs:label "Processing note"@en ;
    rdfs:range xsd:string .

tc:safetyNote a owl:DatatypeProperty ;
    rdfs:label "Sicherheitsmassnahmen"@de ;
    rdfs:label "Safety note"@en ;
    rdfs:range xsd:string .

tc:cleaningNote a owl:DatatypeProperty ;
    rdfs:label "Reinigung"@de ;
    rdfs:label "Cleaning note"@en ;
    rdfs:range xsd:string .

tc:storageConditions a owl:DatatypeProperty ;
    rdfs:label "Lagerbedingungen"@de ;
    rdfs:label "Storage conditions"@en ;
    rdfs:range xsd:string .

tc:labeling a owl:DatatypeProperty ;
    rdfs:label "Kennzeichnung"@de ;
    rdfs:label "Labeling"@en ;
    rdfs:range xsd:string .

tc:hazardLabeling a owl:DatatypeProperty ;
    rdfs:label "Gefahrstoffkennzeichnung"@de ;
    rdfs:label "Hazard labeling"@en ;
    rdfs:range xsd:string .

tc:transportRegulation a owl:DatatypeProperty ;
    rdfs:label "Transportvorschriften"@de ;
    rdfs:label "Transport regulation"@en ;
    rdfs:range xsd:string .

tc:safetyRegulation a owl:DatatypeProperty ;
    rdfs:label "Sicherheitsbestimmungen"@de ;
    rdfs:label "Safety regulation"@en ;
    rdfs:range xsd:string .

