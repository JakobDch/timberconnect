@prefix tc: <http://timberconnect.2050.de/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Externe Ontologien (Linked Building Data)
@prefix bot: <https://w3id.org/bot#> .
@prefix ifc: <https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2/OWL#> .
@prefix bpo: <https://w3id.org/bpo#> .
@prefix omg: <https://w3id.org/omg#> .
@prefix fog: <https://w3id.org/fog#> .

#======================================================================
# TimberConnect Ontologie v5.0
# Erweiterte semantische Modellierung der Holzlieferkette
# Basierend auf Analyse von 610 Merkmalen aus 15 Dateitypen
#
# v5 Aenderungen gegenueber v4:
# - Domain-Constraints fuer mechanische Properties gelockert
# - Spezifische Identifier-Sub-Properties ergaenzt
# - Saatgut-Properties ergaenzt (Samen-Prozentsaetze)
# - Stammzertifikat/Vermehrungsgut-Properties ergaenzt
#
# Externe Ontologien:
# - BOT (Building Topology Ontology): https://w3c-lbd-cg.github.io/bot/
# - ifcOWL: https://technical.buildingsmart.org/standards/ifc/ifc-formats/ifcowl/
# - BPO (Building Product Ontology): https://w3id.org/bpo
# - OMG (Ontology for Managing Geometry): https://w3id.org/omg
# - FOG (File Ontology for Geometry): https://w3id.org/fog
#======================================================================

<http://timberconnect.2050.de/ontology> a owl:Ontology ;
    rdfs:label "TimberConnect Ontologie"@de ;
    rdfs:label "TimberConnect Ontology"@en ;
    rdfs:comment "Ontologie zur semantischen Beschreibung der Holzlieferkette vom Forst bis zur Immobilie"@de ;
    dcterms:created "2026-04-12"^^xsd:date ;
    owl:versionInfo "5.0" ;
    owl:imports <https://w3id.org/bot> ;
    rdfs:seeAlso <https://w3c-lbd-cg.github.io/bot/> ;
    rdfs:seeAlso <https://technical.buildingsmart.org/standards/ifc/ifc-formats/ifcowl/> .

#======================================================================
# TEIL 1: DOMAIN-KLASSEN (Lieferkette)
#======================================================================

tc:SupplyChainEntity a owl:Class ;
    rdfs:label "Lieferketten-Objekt"@de ;
    rdfs:label "Supply Chain Entity"@en ;
    rdfs:comment "Basisklasse fuer alle Objekte in der Holzlieferkette"@de .

tc:Seed a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Saatgut"@de ;
    rdfs:label "Seed"@en ;
    rdfs:comment "Forstsaatgut mit Keimfaehigkeit, Reinheit, Herkunft"@de .

tc:Seedling a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Setzling"@de ;
    rdfs:label "Seedling"@en .

tc:Tree a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Baum"@de ;
    rdfs:label "Tree"@en ;
    rdfs:comment "Stehender Baum im Wald"@de .

tc:Stem a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Stamm"@de ;
    rdfs:label "Stem"@en ;
    rdfs:comment "Gefaellter Baumstamm vor der Aufarbeitung"@de .

tc:Log a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Rundholz"@de ;
    rdfs:label "Log"@en ;
    rdfs:comment "Aufgearbeitetes Rundholzstueck mit Durchmesser und Laenge"@de .

tc:Assortment a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Sortiment"@de ;
    rdfs:label "Assortment"@en ;
    rdfs:comment "Produktklasse/Sortiment fuer Rundholz"@de .

tc:LogPile a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Polter"@de ;
    rdfs:label "Log Pile"@en ;
    rdfs:comment "Gestapelte Rundholzmenge"@de .

tc:SawnTimber a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Schnittholz"@de ;
    rdfs:label "Sawn Timber"@en ;
    rdfs:comment "Gesaegtes Holz mit mechanischen Eigenschaften"@de .

tc:BuildingMaterial a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Baustoff"@de ;
    rdfs:label "Building Material"@en ;
    rdfs:comment "Baustoff (Holz, Beton, etc.)"@de .

tc:BuildingProduct a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Bauprodukt"@de ;
    rdfs:label "Building Product"@en ;
    rdfs:comment "Verarbeitetes Holzprodukt (BSH, CLT, etc.)"@de .

tc:Fastener a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Verbindungsmittel"@de ;
    rdfs:label "Fastener"@en ;
    rdfs:comment "Verbindungsmittel (Schrauben, Naegel, etc.)"@de .

tc:Adhesive a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Klebstoff"@de ;
    rdfs:label "Adhesive"@en .

tc:CLT a owl:Class ;
    rdfs:subClassOf tc:BuildingProduct ;
    rdfs:label "Brettsperrholz"@de ;
    rdfs:label "Cross Laminated Timber"@en ;
    rdfs:comment "Brettsperrholzplatte (CLT/BSP)"@de .

tc:Panel a owl:Class ;
    rdfs:subClassOf tc:BuildingProduct ;
    rdfs:label "Platte"@de ;
    rdfs:label "Panel"@en .

tc:Insulation a owl:Class ;
    rdfs:subClassOf tc:BuildingProduct ;
    rdfs:label "Daemmung"@de ;
    rdfs:label "Insulation"@en .

tc:BuildingElement a owl:Class ;
    rdfs:subClassOf tc:SupplyChainEntity ;
    rdfs:label "Bauelement"@de ;
    rdfs:label "Building Element"@en ;
    rdfs:comment "Eingebautes Element (Wand, Decke, etc.)"@de .

tc:Wall a owl:Class ;
    rdfs:subClassOf tc:BuildingElement ;
    rdfs:label "Wand"@de ;
    rdfs:label "Wall"@en .

tc:Ceiling a owl:Class ;
    rdfs:subClassOf tc:BuildingElement ;
    rdfs:label "Decke"@de ;
    rdfs:label "Ceiling"@en .

tc:Roof a owl:Class ;
    rdfs:subClassOf tc:BuildingElement ;
    rdfs:label "Dach"@de ;
    rdfs:label "Roof"@en .

#======================================================================
# TEIL 2: AKTEUR-KLASSEN
#======================================================================

tc:Actor a owl:Class ;
    rdfs:label "Akteur"@de ;
    rdfs:label "Actor"@en ;
    rdfs:comment "Person oder Organisation mit einer Rolle im Prozess"@de .

tc:Person a owl:Class ;
    rdfs:subClassOf tc:Actor ;
    rdfs:label "Person"@de ;
    rdfs:label "Person"@en .

tc:Organization a owl:Class ;
    rdfs:subClassOf tc:Actor ;
    rdfs:label "Organisation"@de ;
    rdfs:label "Organization"@en .

# Spezifische Akteur-Rollen als Subklassen
tc:MachineOwner a owl:Class ;
    rdfs:subClassOf tc:Person ;
    rdfs:label "Maschinenbesitzer"@de ;
    rdfs:label "Machine Owner"@en .

tc:Operator a owl:Class ;
    rdfs:subClassOf tc:Person ;
    rdfs:label "Bediener"@de ;
    rdfs:label "Operator"@en .

tc:ForestOwner a owl:Class ;
    rdfs:subClassOf tc:Actor ;
    rdfs:label "Waldbesitzer"@de ;
    rdfs:label "Forest Owner"@en ;
    rdfs:comment "Kann Person oder Organisation sein"@de .

tc:LoggingContractor a owl:Class ;
    rdfs:subClassOf tc:Organization ;
    rdfs:label "Holzunternehmer"@de ;
    rdfs:label "Logging Contractor"@en .

tc:LoggingOrganisation a owl:Class ;
    rdfs:subClassOf tc:Organization ;
    rdfs:label "Forstorganisation"@de ;
    rdfs:label "Logging Organisation"@en .

tc:ProductBuyer a owl:Class ;
    rdfs:subClassOf tc:Actor ;
    rdfs:label "Produktkaeufer"@de ;
    rdfs:label "Product Buyer"@en .

tc:ProductDestination a owl:Class ;
    rdfs:subClassOf tc:Actor ;
    rdfs:label "Produktempfaenger"@de ;
    rdfs:label "Product Destination"@en .

tc:Carrier a owl:Class ;
    rdfs:subClassOf tc:Organization ;
    rdfs:label "Spediteur"@de ;
    rdfs:label "Carrier"@en .

tc:Dispatcher a owl:Class ;
    rdfs:subClassOf tc:Person ;
    rdfs:label "Disponent"@de ;
    rdfs:label "Dispatcher"@en .

tc:Tester a owl:Class ;
    rdfs:subClassOf tc:Person ;
    rdfs:label "Pruefer"@de ;
    rdfs:label "Tester"@en .

tc:Sender a owl:Class ;
    rdfs:subClassOf tc:Actor ;
    rdfs:label "Einsender"@de ;
    rdfs:label "Sender"@en .

#======================================================================
# TEIL 3: MASCHINEN-KLASSEN
#======================================================================

tc:Machine a owl:Class ;
    rdfs:label "Maschine"@de ;
    rdfs:label "Machine"@en ;
    rdfs:comment "Forstmaschine (Harvester, Forwarder, etc.)"@de .

tc:MachineHead a owl:Class ;
    rdfs:label "Maschinenkopf"@de ;
    rdfs:label "Machine Head"@en ;
    rdfs:comment "Erntekopf/Aggregat der Maschine"@de .

tc:Sensor a owl:Class ;
    rdfs:label "Sensor"@de ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "Messsensor der Maschine"@de .

#======================================================================
# TEIL 4: DEFINITIONS-KLASSEN (Konfiguration)
#======================================================================

tc:Definition a owl:Class ;
    rdfs:label "Definition"@de ;
    rdfs:label "Definition"@en ;
    rdfs:comment "Konfigurationsdaten fuer Sortierung und Vermessung"@de .

tc:SpeciesGroupDefinition a owl:Class ;
    rdfs:subClassOf tc:Definition ;
    rdfs:label "Artengruppen-Definition"@de ;
    rdfs:label "Species Group Definition"@en ;
    rdfs:comment "Baumart, Sortiment, Rindenabzug"@de .

tc:ProductDefinition a owl:Class ;
    rdfs:subClassOf tc:Definition ;
    rdfs:label "Produkt-Definition"@de ;
    rdfs:label "Product Definition"@en ;
    rdfs:comment "Produktvorgaben fuer Sortierung"@de .

tc:ObjectDefinition a owl:Class ;
    rdfs:subClassOf tc:Definition ;
    rdfs:label "Objekt-Definition"@de ;
    rdfs:label "Object Definition"@en ;
    rdfs:comment "Waldflaeche/Hiebsort"@de .

tc:SubObject a owl:Class ;
    rdfs:subClassOf tc:Definition ;
    rdfs:label "Unterobjekt"@de ;
    rdfs:label "Sub Object"@en ;
    rdfs:comment "Teilflaeche eines Objekts"@de .

tc:PriceMatrix a owl:Class ;
    rdfs:subClassOf tc:Definition ;
    rdfs:label "Preismatrix"@de ;
    rdfs:label "Price Matrix"@en ;
    rdfs:comment "Preismatrix fuer Sortimente"@de .

#======================================================================
# TEIL 5: WEITERE KLASSEN
#======================================================================

tc:Measurement a owl:Class ;
    rdfs:label "Messung"@de ;
    rdfs:label "Measurement"@en ;
    rdfs:comment "Messwert mit Wert und Einheit"@de .

tc:GeoCoordinate a owl:Class ;
    rdfs:label "Geokoordinate"@de ;
    rdfs:label "Geo Coordinate"@en .

tc:Address a owl:Class ;
    rdfs:label "Adresse"@de ;
    rdfs:label "Address"@en .

tc:Transport a owl:Class ;
    rdfs:label "Transport"@de ;
    rdfs:label "Transport"@en ;
    rdfs:comment "Holztransport mit Belade- und Entladestelle"@de .

tc:Test a owl:Class ;
    rdfs:label "Pruefung"@de ;
    rdfs:label "Test"@en ;
    rdfs:comment "Laborpruefung"@de .

tc:GerminationTest a owl:Class ;
    rdfs:subClassOf tc:Test ;
    rdfs:label "Keimpruefung"@de ;
    rdfs:label "Germination Test"@en .

tc:MechanicalTest a owl:Class ;
    rdfs:subClassOf tc:Test ;
    rdfs:label "Mechanische Pruefung"@de ;
    rdfs:label "Mechanical Test"@en .

tc:BendingTest a owl:Class ;
    rdfs:subClassOf tc:MechanicalTest ;
    rdfs:label "Biegepruefung"@de ;
    rdfs:label "Bending Test"@en .

tc:Document a owl:Class ;
    rdfs:label "Dokument"@de ;
    rdfs:label "Document"@en ;
    rdfs:comment "Zertifikat, Pruefbericht, Lieferschein"@de .

tc:Certificate a owl:Class ;
    rdfs:subClassOf tc:Document ;
    rdfs:label "Zertifikat"@de ;
    rdfs:label "Certificate"@en .

tc:TestReport a owl:Class ;
    rdfs:subClassOf tc:Document ;
    rdfs:label "Pruefbericht"@de ;
    rdfs:label "Test Report"@en .

tc:DeliveryNote a owl:Class ;
    rdfs:subClassOf tc:Document ;
    rdfs:label "Lieferschein"@de ;
    rdfs:label "Delivery Note"@en .

tc:DeclarationOfPerformance a owl:Class ;
    rdfs:subClassOf tc:Document ;
    rdfs:label "Leistungserklaerung"@de ;
    rdfs:label "Declaration of Performance"@en .

tc:TransportOrder a owl:Class ;
    rdfs:subClassOf tc:Document ;
    rdfs:label "Transportauftrag"@de ;
    rdfs:label "Transport Order"@en .

tc:Project a owl:Class ;
    rdfs:label "Projekt"@de ;
    rdfs:label "Project"@en ;
    rdfs:comment "Bauprojekt"@de .

tc:HarvestData a owl:Class ;
    rdfs:label "Erntedaten"@de ;
    rdfs:label "Harvest Data"@en ;
    rdfs:comment "Container fuer Ernteinformationen"@de .

tc:EPCISEvent a owl:Class ;
    rdfs:label "EPCIS-Ereignis"@de ;
    rdfs:label "EPCIS Event"@en ;
    rdfs:comment "Tracking-Ereignis nach EPCIS-Standard"@de .

tc:AggregationEvent a owl:Class ;
    rdfs:subClassOf tc:EPCISEvent ;
    rdfs:label "Aggregationsereignis"@de ;
    rdfs:label "Aggregation Event"@en .

#======================================================================
# TEIL 6: OBJECT PROPERTIES (Beziehungen)
#======================================================================

# --- Lieferkette ---
tc:derivedFrom a owl:ObjectProperty ;
    rdfs:label "stammt von"@de ;
    rdfs:label "derived from"@en ;
    rdfs:domain tc:SupplyChainEntity ;
    rdfs:range tc:SupplyChainEntity ;
    rdfs:comment "Verknuepft ein Objekt mit seinem Vorgaenger in der Lieferkette"@de .

tc:partOf a owl:ObjectProperty ;
    rdfs:label "Teil von"@de ;
    rdfs:label "part of"@en .

tc:contains a owl:ObjectProperty ;
    rdfs:label "enthaelt"@de ;
    rdfs:label "contains"@en ;
    owl:inverseOf tc:partOf .

tc:stackedIn a owl:ObjectProperty ;
    rdfs:label "gestapelt in"@de ;
    rdfs:label "stacked in"@en ;
    rdfs:domain tc:Log ;
    rdfs:range tc:LogPile .

tc:belongsToAssortment a owl:ObjectProperty ;
    rdfs:label "gehoert zu Sortiment"@de ;
    rdfs:label "belongs to assortment"@en ;
    rdfs:range tc:Assortment .

# --- Akteure ---
tc:hasOwner a owl:ObjectProperty ;
    rdfs:label "hat Eigentuemer"@de ;
    rdfs:range tc:Actor .

tc:hasOperator a owl:ObjectProperty ;
    rdfs:label "hat Bediener"@de ;
    rdfs:range tc:Operator .

tc:hasBuyer a owl:ObjectProperty ;
    rdfs:label "hat Kaeufer"@de ;
    rdfs:range tc:ProductBuyer .

tc:hasDestination a owl:ObjectProperty ;
    rdfs:label "hat Empfaenger"@de ;
    rdfs:range tc:ProductDestination .

tc:hasCarrier a owl:ObjectProperty ;
    rdfs:label "hat Spediteur"@de ;
    rdfs:range tc:Carrier .

tc:hasForestOwner a owl:ObjectProperty ;
    rdfs:label "hat Waldbesitzer"@de ;
    rdfs:range tc:ForestOwner .

tc:hasContractor a owl:ObjectProperty ;
    rdfs:label "hat Auftragnehmer"@de ;
    rdfs:range tc:LoggingContractor .

tc:hasSender a owl:ObjectProperty ;
    rdfs:label "hat Einsender"@de ;
    rdfs:range tc:Sender .

tc:hasTester a owl:ObjectProperty ;
    rdfs:label "hat Pruefer"@de ;
    rdfs:range tc:Tester .

tc:hasDispatcher a owl:ObjectProperty ;
    rdfs:label "hat Disponent"@de ;
    rdfs:range tc:Dispatcher .

tc:signedBy a owl:ObjectProperty ;
    rdfs:label "unterzeichnet von"@de ;
    rdfs:label "signed by"@en ;
    rdfs:domain tc:Document ;
    rdfs:range tc:Actor .

# --- Maschine ---
tc:harvestedBy a owl:ObjectProperty ;
    rdfs:label "geerntet von"@de ;
    rdfs:label "harvested by"@en ;
    rdfs:domain tc:Stem ;
    rdfs:range tc:Machine .

tc:processedBy a owl:ObjectProperty ;
    rdfs:label "verarbeitet von"@de ;
    rdfs:label "processed by"@en ;
    rdfs:domain tc:Log ;
    rdfs:range tc:Machine .

tc:hasHead a owl:ObjectProperty ;
    rdfs:label "hat Kopf"@de ;
    rdfs:domain tc:Machine ;
    rdfs:range tc:MachineHead .

tc:hasMachineOwner a owl:ObjectProperty ;
    rdfs:label "hat Maschinenbesitzer"@de ;
    rdfs:domain tc:Machine ;
    rdfs:range tc:MachineOwner .

tc:hasSensor a owl:ObjectProperty ;
    rdfs:label "hat Sensor"@de ;
    rdfs:domain tc:Machine ;
    rdfs:range tc:Sensor .

# --- Definitionen ---
tc:hasSpeciesGroup a owl:ObjectProperty ;
    rdfs:label "hat Artengruppe"@de ;
    rdfs:range tc:SpeciesGroupDefinition .

tc:hasProductDefinition a owl:ObjectProperty ;
    rdfs:label "hat Produktdefinition"@de ;
    rdfs:range tc:ProductDefinition .

tc:belongsToObject a owl:ObjectProperty ;
    rdfs:label "gehoert zu Objekt"@de ;
    rdfs:range tc:ObjectDefinition .

tc:hasSubObject a owl:ObjectProperty ;
    rdfs:label "hat Unterobjekt"@de ;
    rdfs:domain tc:ObjectDefinition ;
    rdfs:range tc:SubObject .

tc:hasPriceMatrix a owl:ObjectProperty ;
    rdfs:label "hat Preismatrix"@de ;
    rdfs:range tc:PriceMatrix .

# --- Ort ---
tc:hasLocation a owl:ObjectProperty ;
    rdfs:label "hat Standort"@de ;
    rdfs:range tc:GeoCoordinate .

tc:hasAddress a owl:ObjectProperty ;
    rdfs:label "hat Adresse"@de ;
    rdfs:range tc:Address .

tc:hasFellingLocation a owl:ObjectProperty ;
    rdfs:label "hat Faellort"@de ;
    rdfs:domain tc:Stem ;
    rdfs:range tc:GeoCoordinate .

tc:hasLogLocation a owl:ObjectProperty ;
    rdfs:label "hat Rundholz-Standort"@de ;
    rdfs:domain tc:Log ;
    rdfs:range tc:GeoCoordinate .

# --- Transport ---
tc:transportedBy a owl:ObjectProperty ;
    rdfs:label "transportiert von"@de ;
    rdfs:range tc:Transport .

tc:hasLoadingPoint a owl:ObjectProperty ;
    rdfs:label "hat Beladestelle"@de ;
    rdfs:domain tc:Transport ;
    rdfs:range tc:Address .

tc:hasUnloadingPoint a owl:ObjectProperty ;
    rdfs:label "hat Entladestelle"@de ;
    rdfs:domain tc:Transport ;
    rdfs:range tc:Address .

# --- Messung/Pruefung ---
tc:hasMeasurement a owl:ObjectProperty ;
    rdfs:label "hat Messung"@de ;
    rdfs:range tc:Measurement .

tc:hasDocument a owl:ObjectProperty ;
    rdfs:label "hat Dokument"@de ;
    rdfs:range tc:Document .

tc:hasTest a owl:ObjectProperty ;
    rdfs:label "hat Pruefung"@de ;
    rdfs:range tc:Test .

tc:testedBy a owl:ObjectProperty ;
    rdfs:label "geprueft von"@de ;
    rdfs:range tc:Test .

# --- Projekt ---
tc:belongsToProject a owl:ObjectProperty ;
    rdfs:label "gehoert zu Projekt"@de ;
    rdfs:range tc:Project .

# --- EPCIS ---
tc:hasEPCISEvent a owl:ObjectProperty ;
    rdfs:label "hat EPCIS-Ereignis"@de ;
    rdfs:range tc:EPCISEvent .

tc:hasChildEPC a owl:ObjectProperty ;
    rdfs:label "hat Kind-EPC"@de ;
    rdfs:domain tc:AggregationEvent .

#======================================================================
# TEIL 7: DATATYPE PROPERTIES (Generisch)
#======================================================================

# --- Identifikation ---
tc:identifier a owl:DatatypeProperty ;
    rdfs:label "Identifikator"@de ;
    rdfs:label "identifier"@en ;
    rdfs:comment "Eindeutige Kennung des Objekts"@de ;
    rdfs:range xsd:string .

tc:label a owl:DatatypeProperty ;
    rdfs:label "Bezeichnung"@de ;
    rdfs:label "label"@en ;
    rdfs:comment "Bezeichnung/Label"@de ;
    rdfs:range xsd:string .

tc:name a owl:DatatypeProperty ;
    rdfs:label "Name"@de ;
    rdfs:label "name"@en ;
    rdfs:range xsd:string .

tc:title a owl:DatatypeProperty ;
    rdfs:label "Titel"@de ;
    rdfs:label "title"@en ;
    rdfs:range xsd:string .

tc:description a owl:DatatypeProperty ;
    rdfs:label "Beschreibung"@de ;
    rdfs:label "description"@en ;
    rdfs:range xsd:string .

tc:comment a owl:DatatypeProperty ;
    rdfs:label "Bemerkung"@de ;
    rdfs:label "comment"@en ;
    rdfs:range xsd:string .

# --- Klassifikation ---
tc:category a owl:DatatypeProperty ;
    rdfs:label "Kategorie"@de ;
    rdfs:label "category"@en ;
    rdfs:range xsd:string .

tc:type a owl:DatatypeProperty ;
    rdfs:label "Typ"@de ;
    rdfs:label "type"@en ;
    rdfs:range xsd:string .

# --- Werte ---
tc:value a owl:DatatypeProperty ;
    rdfs:label "Wert"@de ;
    rdfs:label "value"@en ;
    rdfs:range xsd:string .

tc:numericValue a owl:DatatypeProperty ;
    rdfs:label "numerischer Wert"@de ;
    rdfs:label "numeric value"@en ;
    rdfs:range xsd:decimal .

tc:booleanValue a owl:DatatypeProperty ;
    rdfs:label "Wahrheitswert"@de ;
    rdfs:label "boolean value"@en ;
    rdfs:range xsd:boolean .

tc:unit a owl:DatatypeProperty ;
    rdfs:label "Einheit"@de ;
    rdfs:label "unit"@en ;
    rdfs:range xsd:string .

# --- Zeit ---
tc:dateTime a owl:DatatypeProperty ;
    rdfs:label "Datum/Zeit"@de ;
    rdfs:label "date time"@en ;
    rdfs:range xsd:dateTime .

tc:date a owl:DatatypeProperty ;
    rdfs:label "Datum"@de ;
    rdfs:label "date"@en ;
    rdfs:range xsd:date .

tc:createdAt a owl:DatatypeProperty ;
    rdfs:label "Erstellt am"@de ;
    rdfs:range xsd:dateTime .

tc:modifiedAt a owl:DatatypeProperty ;
    rdfs:label "Geaendert am"@de ;
    rdfs:range xsd:dateTime .

tc:harvestedAt a owl:DatatypeProperty ;
    rdfs:label "Geerntet am"@de ;
    rdfs:domain tc:Stem ;
    rdfs:range xsd:dateTime .

tc:printedAt a owl:DatatypeProperty ;
    rdfs:label "Gedruckt am"@de ;
