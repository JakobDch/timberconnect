    rdfs:comment "Anmerkung: Bedeutung unklar"@de ;
    skos:scopeNote "Wertschöpfungsstufe: Holzwerkstoffproduzent"@de .

tc:anstrich_vorhanden a owl:DatatypeProperty ;
    rdfs:label "Anstrich vorhanden"@de ;
    skos:notation "M-1045" ;
    rdfs:domain tc:Panel ;
    rdfs:range xsd:boolean ;
    skos:example "nein" ;
    skos:scopeNote "Wertschöpfungsstufe: Holzwerkstoffproduzent"@de .

