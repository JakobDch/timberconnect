#======================================================================
# TEIL 8: ALIGNMENTS zu externen Ontologien (BOT, ifcOWL)
#======================================================================

# --- Alignment zu BOT (Building Topology Ontology) ---
# https://w3id.org/bot#

# Klassen-Alignments
tc:Wall rdfs:subClassOf bot:Element .
tc:Ceiling rdfs:subClassOf bot:Element .
tc:Roof rdfs:subClassOf bot:Element .
tc:BuildingElement rdfs:subClassOf bot:Element .
tc:Project owl:equivalentClass bot:Site .

# Property-Alignments
tc:partOf rdfs:subPropertyOf bot:containsZone .
tc:contains owl:inverseOf tc:partOf .

# --- Alignment zu ifcOWL ---
# https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2/OWL#

# Klassen-Alignments zu IFC
tc:Wall owl:equivalentClass ifc:IfcWall .
tc:Ceiling owl:equivalentClass ifc:IfcSlab .
tc:BuildingElement owl:equivalentClass ifc:IfcBuildingElement .
tc:BuildingProduct owl:equivalentClass ifc:IfcProduct .

# --- IFC-spezifische Properties (aus PropertySets) ---
# Diese Properties koennen fuer IFC-Daten verwendet werden

tc:ifcGlobalId a owl:DatatypeProperty ;
    rdfs:label "IFC GlobalId"@de ;
    rdfs:comment "Entspricht ifc:globalId_IfcRoot"@de ;
    rdfs:range xsd:string .

tc:ifcObjectType a owl:DatatypeProperty ;
    rdfs:label "IFC ObjectType"@de ;
    rdfs:comment "Entspricht ifc:objectType_IfcObject"@de ;
    rdfs:range xsd:string .

tc:ifcTag a owl:DatatypeProperty ;
    rdfs:label "IFC Tag"@de ;
    rdfs:comment "Entspricht ifc:tag_IfcElement"@de ;
    rdfs:range xsd:string .

# Revit-spezifische Properties (haeufig in IFC-Exporten)
tc:revitFamily a owl:DatatypeProperty ;
    rdfs:label "Revit Familie"@de ;
    rdfs:comment "Revit Family Name aus IFC-Export"@de ;
    rdfs:range xsd:string .

tc:revitType a owl:DatatypeProperty ;
    rdfs:label "Revit Typ"@de ;
    rdfs:comment "Revit Type Name aus IFC-Export"@de ;
    rdfs:range xsd:string .

# Geometrie-Constraints (aus Revit/IFC)
tc:baseConstraint a owl:DatatypeProperty ;
    rdfs:label "Basisebene"@de ;
    rdfs:comment "Ebene an der das Element basiert (Revit Base Constraint)"@de ;
    rdfs:range xsd:string .

tc:topConstraint a owl:DatatypeProperty ;
    rdfs:label "Obere Ebene"@de ;
    rdfs:comment "Obere Begrenzungsebene (Revit Top Constraint)"@de ;
    rdfs:range xsd:string .

tc:baseOffset a owl:DatatypeProperty ;
    rdfs:label "Basis-Versatz"@de ;
    rdfs:range xsd:decimal .

tc:topOffset a owl:DatatypeProperty ;
    rdfs:label "Oberer Versatz"@de ;
    rdfs:range xsd:decimal .

tc:unconnectedHeight a owl:DatatypeProperty ;
    rdfs:label "Nicht verknuepfte Hoehe"@de ;
    rdfs:range xsd:decimal .

# Raumgrenzen
tc:roomBounding a owl:DatatypeProperty ;
    rdfs:label "Raumbegrenzung"@de ;
    rdfs:comment "Ist das Element raumbegrenzend (Revit Room Bounding)"@de ;
    rdfs:range xsd:boolean .

# Thermische Properties (aus Pset_WallCommon etc.)
tc:thermalTransmittance a owl:DatatypeProperty ;
    rdfs:label "Waermedurchgangskoeffizient"@de ;
    rdfs:comment "U-Wert in W/(m2*K)"@de ;
    rdfs:range xsd:decimal .

tc:thermalResistance a owl:DatatypeProperty ;
    rdfs:label "Waermewiderstand"@de ;
    rdfs:comment "R-Wert in (m2*K)/W"@de ;
    rdfs:range xsd:decimal .

tc:thermalMass a owl:DatatypeProperty ;
    rdfs:label "Thermisch wirksame Masse"@de ;
    rdfs:range xsd:decimal .

tc:absorptance a owl:DatatypeProperty ;
    rdfs:label "Absorptionsgrad"@de ;
    rdfs:range xsd:decimal .

tc:roughness a owl:DatatypeProperty ;
    rdfs:label "Rauigkeit"@de ;
    rdfs:range xsd:string .

# Strukturelle Properties
tc:loadBearing a owl:DatatypeProperty ;
    rdfs:label "Tragend"@de ;
    rdfs:comment "Ist das Element tragend (aus Pset_WallCommon/LoadBearing)"@de ;
    rdfs:range xsd:boolean .

tc:isExternal a owl:DatatypeProperty ;
    rdfs:label "Aussenbauteil"@de ;
    rdfs:comment "Ist das Element ein Aussenbauteil (aus Pset_WallCommon/IsExternal)"@de ;
    rdfs:range xsd:boolean .

# Abbund/Produktion (fuer Holzbau-IFC)
tc:productionNumber a owl:DatatypeProperty ;
    rdfs:label "Produktionsnummer"@de ;
    rdfs:comment "Abbund/Produktions-Nummer"@de ;
    rdfs:range xsd:string .

tc:assemblyGroup a owl:DatatypeProperty ;
    rdfs:label "Montagegruppe"@de ;
    rdfs:range xsd:string .

tc:constructionPhase a owl:DatatypeProperty ;
    rdfs:label "Bauabschnitt"@de ;
    rdfs:range xsd:string .

tc:deliveryPhase a owl:DatatypeProperty ;
    rdfs:label "Lieferung/Anlieferung"@de ;
    rdfs:range xsd:string .

tc:surfaceQuality a owl:DatatypeProperty ;
    rdfs:label "Sichtqualitaet"@de ;
    rdfs:comment "z.B. S1, S2, S3 nach DIN 68365"@de ;
    rdfs:range xsd:string .

