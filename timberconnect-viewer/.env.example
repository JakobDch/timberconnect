# Federation Registry URL (discovers all registered Solid Pods)
VITE_FEDERATION_REGISTRY_URL=https://solid-community-server.tmdt.info/semanticdatacatalog/public/dace/

# Semantic Data Catalog JSON API (local fallback)
# VITE_CATALOG_API_URL=http://localhost/api

# EPCIS authorizing proxy URL. Defaults to the same-origin /api/epcis path
# (proxied to the timberconnect-epcis service in dev via vite.config.ts).
# Set an absolute URL when the service is hosted elsewhere.
# VITE_EPCIS_SERVICE_URL=https://your-host/api/epcis
