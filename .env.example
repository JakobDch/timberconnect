# Domain for public hosting (HTTPS will be enabled automatically via Let's Encrypt)
# Use "localhost" for local development, or your actual domain for production
DOMAIN=localhost
# Optional: zweiter Host, unter dem Caddy die App ebenfalls ausliefert.
# Fuer den Test am Mobilgeraet die LAN-IP des Rechners eintragen, z.B.
# LAN_HOST=http://192.168.178.24 — sonst antwortet Caddy ueber die IP
# mit einer leeren Seite. Siehe docs/hardware-scanning.md.
#LAN_HOST=
# Host (ohne Schema!), der den HSTS-Header erhaelt — auf dem Server der
# TLS-Hostname. Der LAN-Host bekommt bewusst kein HSTS, sonst verweigert
# Chrome die per HTTP ausgelieferte Seite dauerhaft.
#TLS_HOST=localhost

# Database credentials
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_PASSWORD=your_password_here
MYSQL_USER=semantic_data_catalog
MYSQL_DATABASE=semantic_data_catalog

# SMTP credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=your_email@example.com

# Fuseki admin password
FUSEKI_ADMIN_PASSWORD=change_this_password

# Solid Pod access token (optional)
SOLID_ACCESS_TOKEN=

# Catalog Registration Settings
CATALOG_ID=1
CATALOG_DEFAULT_CONTACT=timberconnect@2050.de
CATALOG_REGISTRATION_ENABLED=true

# --- EPCIS / GS1 identifier generation (timberconnect-epcis) ---
# Master switch for the rml-converter calling the EPCIS service.
EPCIS_ENABLED=true
# GS1 Company Prefix and per-type item references (defaults = EECC sample values).
TC_EPCIS_GCP=4047111124
TC_EPCIS_ITEMREF_FORST=015
TC_EPCIS_ITEMREF_SAEGEWERK=091
TC_EPCIS_ITEMREF_BSPWERK=100
# Base URL for the EPCIS document reference (EPCIS<->SOLID namespace bridge).
TC_EPCIS_DOC_BASE_URL=https://solid-community-server.tmdt.info/epcisrepository/public/uploads
# EPCAT repository: the official EECC-hosted repo (GS1 EPCIS 2.0 REST).
# Requires a bearer token — put the FULL header value ("Bearer <token>") into
# TC_EPCIS_EPCAT_AUTH in your local .env (never commit the token).
TC_EPCIS_EPCAT_BASE_URL=https://epcat2-timber.prod-k8s.eecc.de/api
TC_EPCIS_EPCAT_AUTH=
TC_EPCIS_EPCAT_ENABLED=true
# Capture robustness: the capture is async and OpenEPCIS has a sporadic race;
# the service polls the job status and retries failed captures, with a minimum
# spacing between consecutive captures.
TC_EPCIS_EPCAT_MAX_ATTEMPTS=3
TC_EPCIS_EPCAT_RETRY_BACKOFF=1.5
TC_EPCIS_EPCAT_POLL_INTERVAL=2
# Generous: under host I/O load capture jobs can take much longer to persist.
TC_EPCIS_EPCAT_POLL_TIMEOUT=90
TC_EPCIS_EPCAT_MIN_SPACING=0.5
