# RML-Mapping fuer PDF-Template: Leistungserklärung Schnittholz (pdf_leistungserklaerung)
# GENERIERT aus services/pdf_template_service.py — nicht von Hand editieren;
# Aenderungen in der Registry vornehmen und generate_pdf_mappings.py ausfuehren.
# Ontologie: TimberConnect v6 (+ PDF-Erweiterung 07/2026)

@base <http://timberconnect.2050.de/mapping/> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tc: <http://timberconnect.2050.de/ontology#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .

<#pdf_leistungserklaerung_main>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/dop/{__docId}" ;
        rr:class tc:DeclarationOfPerformance
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:identifier ;
        rr:objectMap [ rml:reference "nr" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:type ;
        rr:objectMap [ rml:reference "typ" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:typeNumber ;
        rr:objectMap [ rml:reference "typennummer" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:intendedUse ;
        rr:objectMap [ rml:reference "verwendung" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:productName ;
        rr:objectMap [ rml:reference "herstellerbezeichnung" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:manufacturer ;
        rr:objectMap [ rml:reference "herstellerName" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:manufacturerAddress ;
        rr:objectMap [ rml:reference "herstellerStrasse" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:manufacturerAddress ;
        rr:objectMap [ rml:reference "herstellerOrt" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:manufacturerAddress ;
        rr:objectMap [ rml:reference "herstellerLand" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:conformitySystem ;
        rr:objectMap [ rml:reference "konformitaetssystem" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:standardReference ;
        rr:objectMap [ rml:reference "harmonisierteNorm" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:zertifikatsnummer ;
        rr:objectMap [ rml:reference "zertNummer" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:notifiedBody ;
        rr:objectMap [ rml:reference "zertName" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:notifiedBodyAddress ;
        rr:objectMap [ rml:reference "zertStrasse" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:notifiedBodyAddress ;
        rr:objectMap [ rml:reference "zertOrt" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:notifiedBodyAddress ;
        rr:objectMap [ rml:reference "zertLand" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:density ;
        rr:objectMap [ rml:reference "dichte" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:bendingStrength ;
        rr:objectMap [ rml:reference "biegung" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:tensileStrengthParallel ;
        rr:objectMap [ rml:reference "zugFaser" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:tensileStrengthPerpendicular ;
        rr:objectMap [ rml:reference "zugRechtwinklig" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:compressiveStrengthParallel ;
        rr:objectMap [ rml:reference "druckFaser" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:compressiveStrengthPerpendicular ;
        rr:objectMap [ rml:reference "druckRechtwinklig" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:shearStrength ;
        rr:objectMap [ rml:reference "schub" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:elasticModulus ;
        rr:objectMap [ rml:reference "eModul" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:thicknessTolerance ;
        rr:objectMap [ rml:reference "dickenBreitenToleranz" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:fireResistanceClass ;
        rr:objectMap [ rml:reference "brandverhalten" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:fireResistanceClassNational ;
        rr:objectMap [ rml:reference "feuerwiderstand" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:durabilityClass ;
        rr:objectMap [ rml:reference "dauerhaftigkeitPilze" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:durabilityInsects ;
        rr:objectMap [ rml:reference "dauerhaftigkeitInsekten" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:species ;
        rr:objectMap [ rml:reference "holzart" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:hazardousSubstanceEmission ;
        rr:objectMap [ rml:reference "reach" ]
    ] .

<#pdf_leistungserklaerung_saegevorgaenge>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields.sawings[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/dop/{__docId}/saegevorgang/{__sawingIndex}" ;
        rr:class tc:SawingProcess
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:derivedFrom ;
        rr:objectMap [ rml:reference "materialInputEpc" ;
            rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:epc ;
        rr:objectMap [ rml:reference "materialEpc" ;
            rr:termType rr:IRI ]
    ] .

<#pdf_leistungserklaerung_saegevorgaenge_link>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields.sawings[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/dop/{__docId}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:hasSawingProcess ;
        rr:objectMap [ rr:template "http://timberconnect.2050.de/resource/dop/{__docId}/saegevorgang/{__sawingIndex}" ]
    ] .
