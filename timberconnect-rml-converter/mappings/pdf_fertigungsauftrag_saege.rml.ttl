# RML-Mapping fuer PDF-Template: Fertigungsauftrag Säge (pdf_fertigungsauftrag_saege)
# GENERIERT aus services/pdf_template_service.py — nicht von Hand editieren;
# Aenderungen in der Registry vornehmen und generate_pdf_mappings.py ausfuehren.
# Ontologie: TimberConnect v6 (+ PDF-Erweiterung 07/2026)

@base <http://timberconnect.2050.de/mapping/> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tc: <http://timberconnect.2050.de/ontology#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .

<#pdf_fertigungsauftrag_saege_main>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/productionorder/{__docId}" ;
        rr:class tc:ProductionOrder
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:epc ;
        rr:objectMap [ rml:reference "materialEpc" ;
            rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:vorgangsnummer ;
        rr:objectMap [ rml:reference "vorgangsnummer" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:arbeitsplatz ;
        rr:objectMap [ rml:reference "arbeitsplatz" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:datum ;
        rr:objectMap [ rml:reference "datum" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:kaufnummer ;
        rr:objectMap [ rml:reference "kaufnummer" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:box_Sortiment ;
        rr:objectMap [ rml:reference "boxSortiment" ]
    ] ;
