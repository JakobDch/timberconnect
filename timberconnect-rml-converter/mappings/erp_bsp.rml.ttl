<#Article>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/bspPanel/{__docId}/artikel" ;
        rr:class tc:Article
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:artikel ;
        rr:objectMap [ rml:reference "salesOrder.artikel" ]
    ] ;
    rr:predicateObjectMap [
