# RML-Mapping: ERP-BSP-Eingabetabelle (Herstellungsvorgang, XLSX)
#
# Quelle ist NICHT die Exceldatei selbst, sondern das von
# services/erp_excel_service.py erzeugte JSON-Zwischendokument — die jsonKeys
# dort sind die lokalen Namen der Ontologie-Properties (tc:<key>), sodass
# dieses Mapping und die Ontologie ohne Uebersetzungstabelle nebeneinander
# lesbar sind.
#
# Ontologie: TimberConnect v6 — die ERP-Properties (skos:notation M-913 bis
# M-1045) sind dort bereits fuer genau diese Tabelle definiert; die Zuordnung
# der Felder zu den Knoten folgt den deklarierten rdfs:domain-Angaben
# (tc:Panel als zentraler Produktknoten, daneben tc:Article, tc:DeliveryOrder,
# tc:Warehouse, tc:Carrier, tc:DeliveryCondition, tc:Invoice).
# Ausnahme: tc:lieferant (M-1006, domain tc:ForestOwner) steht auf dem
# Panel-Knoten — die Domain der Ontologie passt fachlich nicht zum
# Transportauftrag eines BSP-Werks.
#
# Idente (Blatt "Identifikation") — Erweiterungsmodul
# timberconnect_epcis_extension.ttl:
#   tc:epc          Identity        Output: die hergestellte BSP-Platte (IRI)
#   tc:derivedFrom  IdentityInput   Input: Lamellen/Lose aus dem Aufsaegevorgang
# Eine Datei = eine Platte = ein EPCIS TransformationEvent.
#
# {{SOURCE_FILE}} wird zur Laufzeit durch den JSON-Dateinamen ersetzt.

@base <http://timberconnect.2050.de/mapping/> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tc: <http://timberconnect.2050.de/ontology#> .

# =============================================================================
# PANEL — die hergestellte BSP-Platte (zentraler Knoten)
# =============================================================================

<#Panel>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/bspPanel/{__docId}" ;
        rr:class tc:Panel
    ] ;

    # --- Idente: Abfrage-Einstieg tc:epc, Materialfluss tc:derivedFrom -------
    rr:predicateObjectMap [
        rr:predicate tc:epc ;
        rr:objectMap [ rml:reference "identification.identity" ;
            rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:derivedFrom ;
        rr:objectMap [ rml:reference "identification.identityInput" ;
            rr:termType rr:IRI ]
    ] ;

    # --- Verknuepfungen zu den Nebenknoten -----------------------------------
    rr:predicateObjectMap [
        rr:predicate tc:hasArticle ;
        rr:objectMap [ rr:template "http://timberconnect.2050.de/resource/bspPanel/{__docId}/artikel" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:hasDeliveryOrder ;
        rr:objectMap [ rr:template "http://timberconnect.2050.de/resource/bspPanel/{__docId}/lieferauftrag" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:hasWarehouse ;
        rr:objectMap [ rr:template "http://timberconnect.2050.de/resource/bspPanel/{__docId}/lager" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:hasCarrier ;
        rr:objectMap [ rr:template "http://timberconnect.2050.de/resource/bspPanel/{__docId}/spediteur" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:hasDeliveryCondition ;
        rr:objectMap [ rr:template "http://timberconnect.2050.de/resource/bspPanel/{__docId}/lieferbedingung" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:hasInvoice ;
        rr:objectMap [ rr:template "http://timberconnect.2050.de/resource/bspPanel/{__docId}/rechnung" ]
    ] ;

    # --- Vertriebsauftrag (Panel-Domain) -------------------------------------
    rr:predicateObjectMap [
        rr:predicate tc:bezug ;
        rr:objectMap [ rml:reference "salesOrder.bezug" ]
    ] ;
