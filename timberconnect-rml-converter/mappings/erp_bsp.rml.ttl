        rr:objectMap [ rml:reference "transportOrder.qS_Kontrolle" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:hinweis_intern ;
        rr:objectMap [ rml:reference "transportOrder.hinweis_intern" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:abholung_Termin ;
        rr:objectMap [ rml:reference "transportOrder.abholung_Termin" ;
            rr:datatype xsd:date ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:abholung_Uhrzeit ;
        rr:objectMap [ rml:reference "transportOrder.abholung_Uhrzeit" ;
            rr:datatype xsd:time ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:abholung_PLZ ;
        rr:objectMap [ rml:reference "transportOrder.abholung_PLZ" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:abholung_Ort ;
        rr:objectMap [ rml:reference "transportOrder.abholung_Ort" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:lieferung_Termin ;
        rr:objectMap [ rml:reference "transportOrder.lieferung_Termin" ;
            rr:datatype xsd:date ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:lieferung_Uhrzeit ;
        rr:objectMap [ rml:reference "transportOrder.lieferung_Uhrzeit" ;
            rr:datatype xsd:time ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:lieferung_PLZ ;
        rr:objectMap [ rml:reference "transportOrder.lieferung_PLZ" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:lieferung_Ort ;
        rr:objectMap [ rml:reference "transportOrder.lieferung_Ort" ]
    ] ;

    # --- Ausgangsrechnung (Panel-Domain) -------------------------------------
    rr:predicateObjectMap [
        rr:predicate tc:belegdatum_v2 ;
        rr:objectMap [ rml:reference "invoice.belegdatum_v2" ;
            rr:datatype xsd:date ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:leistungsdatum ;
        rr:objectMap [ rml:reference "invoice.leistungsdatum" ;
            rr:datatype xsd:date ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:buchungsdatum ;
        rr:objectMap [ rml:reference "invoice.buchungsdatum" ;
            rr:datatype xsd:date ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:steuerschluessel ;
        rr:objectMap [ rml:reference "invoice.steuerschluessel" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:artikelpreis_Klassifikation ;
        rr:objectMap [ rml:reference "invoice.artikelpreis_Klassifikation" ;
            rr:datatype xsd:decimal ]
    ] .

