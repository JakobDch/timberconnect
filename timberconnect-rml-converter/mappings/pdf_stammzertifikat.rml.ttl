        rr:objectMap [ rml:reference "ursprungAusgangsmaterial" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:seedOrigin ;
        rr:objectMap [ rml:reference "saatgutAus" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:maturityYear ;
        rr:objectMap [ rml:reference "reifejahr" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:amount ;
        rr:objectMap [ rml:reference "menge" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:amountInWords ;
        rr:objectMap [ rml:reference "mengeInWorten" ]
    ] ;
    rr:predicateObjectMap [
