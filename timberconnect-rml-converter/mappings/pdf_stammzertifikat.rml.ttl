    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:firstRecipientAddress ;
        rr:objectMap [ rml:reference "empfaengerAnschrift" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:supplierName ;
        rr:objectMap [ rml:reference "lieferantName" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:supplierAddress ;
        rr:objectMap [ rml:reference "lieferantAnschrift" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:businessId ;
        rr:objectMap [ rml:reference "lieferantBetriebsnummer" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:stateAuthorityName ;
        rr:objectMap [ rml:reference "landesstelleName" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:stateAuthorityAddress ;
        rr:objectMap [ rml:reference "landesstelleAnschrift" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:city ;
        rr:objectMap [ rml:reference "ort" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:date ;
        rr:objectMap [ rml:reference "datum" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:authorizedPersonName ;
        rr:objectMap [ rml:reference "bevollmaechtigter" ]
    ] .

<#pdf_stammzertifikat_pflanzflaeche>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/certificate/{__docId}/saatgut" ;
        rr:class tc:Seed
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:epc ;
        rr:objectMap [ rml:reference "materialEpc" ;
            rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:plantingArea ;
        rr:objectMap [ rml:reference "pflanzflaeche" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate geo:asWKT ;
        rr:objectMap [ rml:reference "pflanzflaecheWkt" ;
            rr:datatype geo:wktLiteral ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate wgs84:lat ;
        rr:objectMap [ rml:reference "pflanzflaecheLat" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate wgs84:long ;
        rr:objectMap [ rml:reference "pflanzflaecheLon" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:appliedQuantity ;
        rr:objectMap [ rml:reference "ausgebrachteMenge" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:appliedQuantityUom ;
        rr:objectMap [ rml:reference "ausgebrachteMengeEinheit" ;
            rr:datatype xsd:string ]
    ] .

<#pdf_stammzertifikat_pflanzflaeche_link>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/certificate/{__docId}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:describes ;
        rr:objectMap [ rr:template "http://timberconnect.2050.de/resource/certificate/{__docId}/saatgut" ]
    ] .
