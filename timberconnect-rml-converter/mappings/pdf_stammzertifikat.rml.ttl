    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:purity ;
        rr:objectMap [ rml:reference "anteilReinesSaatgut" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:materialAuthenticity ;
        rr:objectMap [ rml:reference "teilungGroesserePartie" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:predecessorCertificateNumber ;
        rr:objectMap [ rml:reference "vorlaeuferZertifikatNr" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:initialLotAmount ;
        rr:objectMap [ rml:reference "mengeAnfangspartie" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:nurseryCultivationDuration ;
        rr:objectMap [ rml:reference "anzuchtDauer" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:familyCount ;
        rr:objectMap [ rml:reference "familien" ;
            rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:cloneCount ;
        rr:objectMap [ rml:reference "klone" ;
            rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:geneticModification ;
        rr:objectMap [ rml:reference "gentechnik" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:crossingMethod ;
        rr:objectMap [ rml:reference "kreuzungsmethode" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:componentFamilyComposition ;
        rr:objectMap [ rml:reference "komponentenfamilien" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:vegetativePropagation ;
        rr:objectMap [ rml:reference "vegetativVermehrt" ]
    ] ;
