# RML-Mapping fuer PDF-Template: Stammzertifikat Vermehrungsgut (pdf_stammzertifikat)
# GENERIERT aus services/pdf_template_service.py — nicht von Hand editieren;
# Aenderungen in der Registry vornehmen und generate_pdf_mappings.py ausfuehren.
# Ontologie: TimberConnect v6 (+ PDF-Erweiterung 07/2026)

@base <http://timberconnect.2050.de/mapping/> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tc: <http://timberconnect.2050.de/ontology#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .

<#pdf_stammzertifikat_main>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/certificate/{__docId}" ;
        rr:class tc:Certificate
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:epc ;
        rr:objectMap [ rml:reference "materialEpc" ;
            rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:identifier ;
        rr:objectMap [ rml:reference "zertifikatNr" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:distributionList ;
        rr:objectMap [ rml:reference "verteilerErntegut" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:distributionList ;
        rr:objectMap [ rml:reference "verteilerWaldbesitzer" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:distributionList ;
        rr:objectMap [ rml:reference "verteilerBehoerde" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:distributionList ;
        rr:objectMap [ rml:reference "verteilerKontrollstelle" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:guideline ;
        rr:objectMap [ rml:reference "rechtEgRichtlinie" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:guideline ;
        rr:objectMap [ rml:reference "rechtUebergangsregelungen" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:distributionList ;
        rr:objectMap [ rml:reference "verteiler" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:guideline ;
        rr:objectMap [ rml:reference "rechtsgrundlage" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:species ;
        rr:objectMap [ rml:reference "baumart" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:sourceMaterialName ;
        rr:objectMap [ rml:reference "ausgangsmaterialName" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:propagationMaterialType ;
        rr:objectMap [ rml:reference "artVermehrungsgut" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:propagationCategory ;
        rr:objectMap [ rml:reference "vermehrungsgutkategorie" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:sourceType ;
        rr:objectMap [ rml:reference "artAusgangsmaterial" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:intendedUse ;
        rr:objectMap [ rml:reference "verwendungszweck" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:registerSign ;
        rr:objectMap [ rml:reference "registerzeichen" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:admissionUnitOwner ;
        rr:objectMap [ rml:reference "eigentuemerZulassungseinheit" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:admissionUnitOwner ;
        rr:objectMap [ rml:reference "eigentuemerZulassungseinheit2" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:origin ;
        rr:objectMap [ rml:reference "gebietsursprung" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:sourceMaterialCountry ;
        rr:objectMap [ rml:reference "landAusgangsmaterial" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:provenanceRegionName ;
        rr:objectMap [ rml:reference "herkunftsgebietBezeichnung" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:provenanceRegionNumber ;
        rr:objectMap [ rml:reference "herkunftsgebietNr" ]
    ] ;
    rr:predicateObjectMap [
