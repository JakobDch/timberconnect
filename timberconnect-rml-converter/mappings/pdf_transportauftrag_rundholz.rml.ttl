# RML-Mapping fuer PDF-Template: Transportauftrag Rundholz (pdf_transportauftrag_rundholz)
# GENERIERT aus services/pdf_template_service.py — nicht von Hand editieren;
# Aenderungen in der Registry vornehmen und generate_pdf_mappings.py ausfuehren.
# Ontologie: TimberConnect v6 (+ PDF-Erweiterung 07/2026)

@base <http://timberconnect.2050.de/mapping/> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tc: <http://timberconnect.2050.de/ontology#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .

<#pdf_transportauftrag_rundholz_main>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/transportorderrundholz/{__docId}" ;
        rr:class tc:TransportOrder
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:epc ;
        rr:objectMap [ rml:reference "materialEpc" ;
            rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:kaufnummer ;
        rr:objectMap [ rml:reference "kaufnummer" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:los_Nr ;
        rr:objectMap [ rml:reference "losNr" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:datum ;
        rr:objectMap [ rml:reference "datum" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:abfuhrfrist ;
        rr:objectMap [ rml:reference "abfuhrfrist" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:gueltigkeit_von ;
        rr:objectMap [ rml:reference "gueltigkeitVon" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:gueltigkeit_bis ;
        rr:objectMap [ rml:reference "gueltigkeitBis" ]
    ] ;
    rr:predicateObjectMap [
