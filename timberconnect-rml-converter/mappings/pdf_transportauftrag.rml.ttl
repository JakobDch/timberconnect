# RML-Mapping fuer PDF-Template: Transportauftrag Schnittholz (pdf_transportauftrag)
# GENERIERT aus services/pdf_template_service.py — nicht von Hand editieren;
# Aenderungen in der Registry vornehmen und generate_pdf_mappings.py ausfuehren.
# Ontologie: TimberConnect v6 (+ PDF-Erweiterung 07/2026)

@base <http://timberconnect.2050.de/mapping/> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tc: <http://timberconnect.2050.de/ontology#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .

<#pdf_transportauftrag_main>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/transportorder/{__docId}" ;
        rr:class tc:TransportOrder
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:epc ;
        rr:objectMap [ rml:reference "materialEpc" ;
            rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:transportNumber ;
        rr:objectMap [ rml:reference "transportNr" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:deliveryNumber ;
        rr:objectMap [ rml:reference "lieferungsnummern" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:printedAt ;
        rr:objectMap [ rml:reference "gedruckt" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:modifiedAt ;
        rr:objectMap [ rml:reference "letzteAenderung" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:identifier ;
        rr:objectMap [ rml:reference "transporeonId" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:dispatchOffice ;
        rr:objectMap [ rml:reference "dispositionsstelle" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:dispatcherName ;
        rr:objectMap [ rml:reference "disponent" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:grossWeight ;
        rr:objectMap [ rml:reference "gewicht" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:volume ;
        rr:objectMap [ rml:reference "volumen" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:emission ;
        rr:objectMap [ rml:reference "co2Emission" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:businessName ;
        rr:objectMap [ rml:reference "spedition" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:street ;
        rr:objectMap [ rml:reference "speditionStrasse" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:city ;
        rr:objectMap [ rml:reference "speditionOrt" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:phone ;
        rr:objectMap [ rml:reference "speditionTel" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:fax ;
        rr:objectMap [ rml:reference "speditionFax" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:messageRequired ;
        rr:objectMap [ rml:reference "messageRequired" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:loadingPointDescription ;
        rr:objectMap [ rml:reference "beladestelle" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:maxPrice ;
        rr:objectMap [ rml:reference "maxPreis" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:actualPrice ;
        rr:objectMap [ rml:reference "actPreis" ;
            rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:transportStatus ;
        rr:objectMap [ rml:reference "transportAbgefertigt" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:oceanTransportEnabled ;
        rr:objectMap [ rml:reference "oceanSeaRtv" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:reference ;
        rr:objectMap [ rml:reference "tdlnrParam" ]
    ] .

<#pdf_transportauftrag_lieferung>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/transportorder/{__docId}/lieferung" ;
        rr:class tc:DeliveryOrder
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:epc ;
        rr:objectMap [ rml:reference "materialEpc" ;
            rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:loadingAddress ;
        rr:objectMap [ rml:reference "beladeName" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:loadingAddress ;
        rr:objectMap [ rml:reference "beladeStrasse" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:loadingAddress ;
        rr:objectMap [ rml:reference "beladeOrt" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:startDate ;
        rr:objectMap [ rml:reference "datumBeladung" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:unloadingAddress ;
        rr:objectMap [ rml:reference "entladeName" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:unloadingAddress ;
        rr:objectMap [ rml:reference "entladeStrasse" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:unloadingAddress ;
        rr:objectMap [ rml:reference "entladeOrt" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:phone ;
        rr:objectMap [ rml:reference "entladeTel" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:endDate ;
        rr:objectMap [ rml:reference "datumEntladung" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:incoterm ;
        rr:objectMap [ rml:reference "incoterm" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:hazardClass ;
        rr:objectMap [ rml:reference "gefahrenklasse" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:orderNumber ;
        rr:objectMap [ rml:reference "purchaseOrderNo" ]
    ] .

<#pdf_transportauftrag_lieferung_link>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.fields"
    ] ;
    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/transportorder/{__docId}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:hasDeliveryOrder ;
        rr:objectMap [ rr:template "http://timberconnect.2050.de/resource/transportorder/{__docId}/lieferung" ]
    ] .
