@base <http://timberconnect.2050.de/mapping/> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tc: <http://timberconnect.2050.de/ontology#> .
@prefix tcr: <http://timberconnect.2050.de/resource/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .

# =============================================================================
# ELDAT delivery note (Lieferschein) — real KWF structure, migrated to v6 vocab:
#   document.eldat.delivery_note.origin[].pile_data[]  -> tc:LogPile
#   ...transfer.delivery   -> tc:DeliveryNote
#   ...transfer.haulier    -> tc:Carrier
#   ...transfer.haul_means -> tc:Transport
# The pile (Polter) is the central lot-based wood entity; it links to the
# delivery note, carrier and transport that move it.
# =============================================================================

# --- Pile / Polter -> tc:LogPile (one per pile_data entry) -------------------
<#PileMapping>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.document.eldat.delivery_note.origin[*].pile_data[*]"
    ] ;

    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/pile/{wood_id[0].wood_id_no}" ;
        rr:class tc:LogPile
    ] ;

    # Wood identification
    rr:predicateObjectMap [
        rr:predicate tc:identifier ;
        rr:objectMap [ rml:reference "wood_id[0].wood_id_no" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:woodIdType ;
        rr:objectMap [ rml:reference "wood_id[0].wood_id_type" ]
    ] ;

    # Product / wood definition (first product_data entry)
    rr:predicateObjectMap [
        rr:predicate tc:species ;
        rr:objectMap [ rml:reference "product_data[0].wood_definition.species" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:grade ;
        rr:objectMap [ rml:reference "product_data[0].wood_definition.grade" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:use ;
        rr:objectMap [ rml:reference "product_data[0].wood_definition.use" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:aggregationType ;
        rr:objectMap [ rml:reference "product_data[0].aggregation_type" ]
    ] ;

    # Quality (first quality entry)
    rr:predicateObjectMap [
        rr:predicate tc:qualityType ;
        rr:objectMap [ rml:reference "product_data[0].wood_definition.quality[0].qual_type" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:qualityRatio ;
        rr:objectMap [
            rml:reference "product_data[0].wood_definition.quality[0].qual_rat" ;
            rr:datatype xsd:decimal
        ]
    ] ;

    # Amount (first amount entry)
    rr:predicateObjectMap [
        rr:predicate tc:amount ;
        rr:objectMap [
            rml:reference "product_data[0].wood_definition.amount[0].amount_value" ;
            rr:datatype xsd:decimal
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:amountUnit ;
        rr:objectMap [ rml:reference "product_data[0].wood_definition.amount[0].amount_unit" ]
    ] ;

    # Coordinates
    rr:predicateObjectMap [
        rr:predicate geo:lat ;
        rr:objectMap [
            rml:reference "coordinate.latitude" ;
            rr:datatype xsd:decimal
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate geo:long ;
        rr:objectMap [
            rml:reference "coordinate.longitude" ;
            rr:datatype xsd:decimal
        ]
    ] .
    # Hinweis: Die Verknuepfung Pile->DeliveryNote/Carrier braucht einen
    # Cross-Iterator-Join (absoluter JSONPath), den rmlmapper 7.2.0 im
    # pile_data-Iterator nicht aufloest. Die Entitaeten (LogPile, DeliveryNote,
    # Carrier, Transport) sind einzeln vorhanden und ueber die delivery_no
    # zusammenfuehrbar; explizite Links werden bei einem Join-faehigen Mapper
    # (z.B. CARML/rmlmapper mit rr:parentTriplesMap ueber JSON) ergaenzt.

# --- Delivery note -> tc:DeliveryNote ----------------------------------------
<#DeliveryNoteMapping>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.document.eldat.delivery_note.transfer.delivery"
    ] ;

    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/delivery/{delivery_no}" ;
        rr:class tc:DeliveryNote
    ] ;

    rr:predicateObjectMap [
        rr:predicate tc:deliveryNumber ;
        rr:objectMap [ rml:reference "delivery_no" ]
    ] .

# --- Haulier -> tc:Carrier (Spediteur) ---------------------------------------
<#HaulierMapping>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.document.eldat.delivery_note.transfer.haulier"
    ] ;

    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/carrier/{haulier_surname}" ;
        rr:class tc:Carrier
    ] ;

    rr:predicateObjectMap [
        rr:predicate tc:haulierName ;
        rr:objectMap [ rml:reference "haulier_name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:haulierSurname ;
        rr:objectMap [ rml:reference "haulier_surname" ]
    ] .

# --- Haul means -> tc:Transport (Transportmittel) ----------------------------
<#TransportMapping>
    rml:logicalSource [
        rml:source "{{SOURCE_FILE}}" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.document.eldat.delivery_note.transfer.haul_means[*]"
    ] ;

    rr:subjectMap [
        rr:template "http://timberconnect.2050.de/resource/transport/{haul_means_no}" ;
        rr:class tc:Transport
    ] ;

    rr:predicateObjectMap [
        rr:predicate tc:haulMeansNo ;
        rr:objectMap [ rml:reference "haul_means_no" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:amount ;
        rr:objectMap [
            rml:reference "amount[0].amount_value" ;
            rr:datatype xsd:decimal
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tc:amountUnit ;
        rr:objectMap [ rml:reference "amount[0].amount_unit" ]
    ] .
